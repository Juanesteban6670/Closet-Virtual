APP_NAME=Virtual Closet API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://virtual-closet:virtual-closet@localhost:5432/virtual_closet
CORS_ORIGINS=["http://localhost:5173"]
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO
