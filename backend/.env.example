VIRTUAL_CLOSET_APP_NAME=Virtual Closet API
VIRTUAL_CLOSET_APP_ENV=development
VIRTUAL_CLOSET_DEBUG=true
VIRTUAL_CLOSET_API_V1_PREFIX=/api/v1
VIRTUAL_CLOSET_DATABASE_URL=postgresql+psycopg://virtual-closet:virtual-closet@localhost:5432/virtual_closet
VIRTUAL_CLOSET_CORS_ORIGINS=["http://localhost:5173"]
VIRTUAL_CLOSET_JWT_SECRET_KEY=replace-with-a-long-random-secret
VIRTUAL_CLOSET_JWT_ALGORITHM=HS256
VIRTUAL_CLOSET_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
VIRTUAL_CLOSET_JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
VIRTUAL_CLOSET_REFRESH_COOKIE_NAME=virtual_closet_refresh_token
VIRTUAL_CLOSET_COOKIE_SECURE=false
VIRTUAL_CLOSET_COOKIE_SAMESITE=lax
VIRTUAL_CLOSET_LOG_LEVEL=INFO
